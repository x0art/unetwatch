# uNetWatch Environment Configuration
# Copy this file to .env and fill in the values.

# ── Application ──────────────────────────────────────────────────
# APP_ENV=development  (set to "production" for hard fail-fast checks)
APP_ENV=development

# ── Elasticsearch ────────────────────────────────────────────────
ELASTIC_HOST=http://localhost:9200
ELASTIC_INDEX=logstash-proxy-*
ELASTIC_USER=elastic
ELASTIC_PASS=changeme

# ── Webhooks ─────────────────────────────────────────────────────
# n8n / generic webhook for aggregated findings
WEBHOOK_URL=

# Microsoft Teams Workflows webhook URL for Adaptive Card alerts
# (empty = disabled). Create one at:
#   Teams channel → Connectors → Workflows → Create
MSTEAMS_WEBHOOK_URL=

# Base URL for generating clickable action links in MS Teams alerts
# (e.g. "https://unetwatch.example.com"). Used for Block Source IP,
# Block Domain, and Add to Whitelist action buttons.
BASE_URL=

# ── Auth ─────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=changeme
API_KEY=

# ── Monitoring ───────────────────────────────────────────────────
# POLL_INTERVAL_MINUTES=10
# ES_QUERY_SIZE=5000
# REDIRECT_CHECK_INTERVAL_MINUTES=60
# REDIRECT_TIMEOUT_SECONDS=10

# ── Retention ────────────────────────────────────────────────────
# LOG_RETENTION_DAYS=30
# LOG_MAX_ROWS=1000

# ── Blacklist Feeds ──────────────────────────────────────────────
# BLACKLIST_DIR=./data

# Upstream blacklists: two independent feeds, fetched every 5 min and merged
# (deduplicated) into the blacklist. Format: one entry per line,
# `#` or `;` comment lines allowed. Each empty value = that feed disabled.
# UPSTREAM_BLACKLIST_URLS=https://gist.githubusercontent.com/<user>/<id>/raw/urls.txt
# UPSTREAM_BLACKLIST_IPS=https://gist.githubusercontent.com/<user>/<id>/raw/ips.txt

# ── CORS ─────────────────────────────────────────────────────────
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
