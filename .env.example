# uNetWatch configuration — copy to .env and edit.
# All variables are optional and have safe defaults for development.

# Runtime environment: development | production
# In production the app refuses to boot with default/weak admin credentials.
APP_ENV=development

# Elasticsearch Configuration
ELASTIC_HOST=http://localhost:9200
ELASTIC_INDEX=logstash-proxy-*
ELASTIC_USER=elastic
ELASTIC_PASS=changeme

# Webhook Configuration
WEBHOOK_URL=https://n8n.example.com/webhook/your-webhook-id

# Polling Interval (minutes)
POLL_INTERVAL_MINUTES=10

# ES Query Size
ES_QUERY_SIZE=5000

# Redirect tracking
REDIRECT_CHECK_INTERVAL_MINUTES=60
REDIRECT_TIMEOUT_SECONDS=10

# Admin auth (for dashboard login)
ADMIN_USER=admin
ADMIN_PASS=changeme
API_KEY=

# Allowed CORS origins (comma-separated). Defaults to the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite database file
DATABASE_URL=sqlite:///./unetwatch.db

# Directory holding the static blacklist feed files (urls.txt / ips.txt).
# Regenerated from the DB at startup and after every change; served as real
# files at /api/blacklist/{urls,ips}.txt. Relative paths resolve against the
# working directory (in Docker: /app, so ./data == the compose volume).
BLACKLIST_DIR=./data
